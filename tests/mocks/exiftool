#!/usr/bin/env python3
import sys
import os
import json
import mimetypes

if "-ver" in sys.argv:
    print("12.50")
    sys.exit(0)

target = sys.argv[-1]
if not os.path.exists(target):
    sys.exit(1)

size = os.path.getsize(target)
base = os.path.basename(target)
ext = os.path.splitext(target)[1].lstrip(".").upper() or "BIN"
mime, _ = mimetypes.guess_type(target)
mime_val = mime or ("text/plain" if target.endswith(".txt") else "application/octet-stream")

if "-j" in sys.argv:
    result = [{
        "SourceFile": target,
        "FileName": base,
        "FileSize": size,
        "FileType": ext,
        "File:FileType": ext,
        "MIMEType": mime_val
    }]
    print(json.dumps(result))
else:
    print(f"{'SourceFile':<32}: {target}")
    print(f"{'File Name':<32}: {base}")
    print(f"{'File Size':<32}: {size} bytes")
    print(f"{'File Type':<32}: {ext}")
    print(f"{'MIME Type':<32}: {mime_val}")
