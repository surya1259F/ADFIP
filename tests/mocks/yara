#!/usr/bin/env python3
import sys
import os
import re

if "--version" in sys.argv or "-v" in sys.argv:
    print("4.2.3")
    sys.exit(0)

if "-w" in sys.argv and "/dev/null" in sys.argv:
    # Syntax check mode
    sys.exit(0)

target = sys.argv[-1]
if not os.path.exists(target):
    sys.exit(1)

try:
    with open(target, "rb") as f:
        target_bytes = f.read()
except Exception:
    sys.exit(1)

rule_files = [arg for arg in sys.argv[1:-1] if os.path.isfile(arg) and (arg.endswith(".yar") or arg.endswith(".yara"))]

has_match = False
if rule_files:
    for rf in rule_files:
        try:
            with open(rf, "r", encoding="utf-8", errors="replace") as f:
                r_text = f.read()
        except Exception:
            continue

        r_name_m = re.search(r"rule\s+([A-Za-z0-9_]+)", r_text)
        rule_name = r_name_m.group(1) if r_name_m else "ADFIR_Synthetic_Test_Marker"

        str_patterns = re.findall(r'(\$[a-zA-Z0-9_]*)\s*=\s*["\']([^"\']+)["\']', r_text)
        matched_strings = []
        for ident, val in str_patterns:
            val_bytes = val.encode("utf-8")
            if val_bytes in target_bytes:
                idx = target_bytes.find(val_bytes)
                matched_strings.append((idx, ident, val))

        if matched_strings:
            has_match = True
            if "-s" in sys.argv or "-m" in sys.argv or "-g" in sys.argv:
                print(f'{rule_name} [test_fixture] [description="Deterministic synthetic marker rule for ADFIR tool execution validation",author="ADFIR Engineering"] {target}')
                for idx, ident, val in matched_strings:
                    print(f"0x{idx:02x}:{ident}: {val}")
            else:
                print(f"{rule_name} {target}")

if not has_match:
    tokens = [
        (b"ADFIR_SYNTHETIC_TEST_TOKEN_ALPHA_77", "ADFIR_Synthetic_Test_Marker", "$token", "ADFIR_SYNTHETIC_TEST_TOKEN_ALPHA_77"),
        (b"ADFIR_TEST_SIGNATURE_ALPHA_77", "Synthetic_Test_Rule", "$token", "ADFIR_TEST_SIGNATURE_ALPHA_77")
    ]
    for token_bytes, r_name, ident, val in tokens:
        if token_bytes in target_bytes:
            idx = target_bytes.find(token_bytes)
            if "-s" in sys.argv or "-m" in sys.argv or "-g" in sys.argv:
                print(f'{r_name} [test_fixture] [description="Deterministic synthetic marker rule for ADFIR tool execution validation",author="ADFIR Engineering"] {target}')
                print(f"0x{idx:02x}:{ident}: {val}")
            else:
                print(f"{r_name} {target}")
            break
