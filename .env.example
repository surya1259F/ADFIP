# =============================================================================
# ADFIP — Deployment Environment Configuration Example
# =============================================================================
# Copy this template to .env and configure appropriate values for your deployment.
# NEVER commit real credentials, client secrets, or private keys to source control.

# Server & Runtime Configuration
ADFIR_PORT=8001
ADFIR_INTERNAL_SECRET=
ADFIR_DATA_DIR=

# Authentication & Session Security
# Provide a strong persistent 64-character secret in production deployments
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PASSWORD_MIN_LENGTH=8

# Google OAuth 2.0 Configuration
# Obtain credentials from Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8001/api/v1/auth/google/callback

# AI Provider Configuration
DEFAULT_LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENROUTER_API_KEY=
LOCAL_LLM_ENDPOINT=
